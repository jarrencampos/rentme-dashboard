# Firebase Admin SDK (used by API routes for server-side auth and Firestore access)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# SMTP (email sending via nodemailer)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-email-password

# Admin email (recipient for notification emails)
ADMIN_EMAIL=support@rentme.co

# CORS - allowed origin for API requests (defaults to production domain)
ALLOWED_ORIGIN=https://dashboard.rentme.co

# Vercel (automatically set by Vercel, or override for local dev)
# VERCEL_URL=localhost:3000
# BASE_URL=http://localhost:3000
