rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vendors: anyone can read (needed for product details pages),
    // only the authenticated vendor can write their own document
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == vendorId;

      // Vendor subcollections (orders, payments) scoped to the vendor
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == vendorId;
      }
    }

    // Products/listings: anyone can read, only the owner can write
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.vendorId == request.auth.uid;
    }

    // New products (pending approval) — only the vendor who owns them
    match /newProducts/{productId} {
      allow read: if request.auth != null
                  && resource.data.vendorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.vendorId == request.auth.uid;
    }

    // Orders: vendor can read their own orders, anyone can create
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.vendorId == request.auth.uid;
      allow create: if true;
      allow update, delete: if false;
    }

    // Details collection (product details)
    match /details/{detailId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Details subcollections (reviews, specifications, photos)
      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Customers: anyone can read (needed for review display)
    match /customers/{customerId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
