rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vendors: only the authenticated vendor can read/write their own document
    match /vendors/{vendorId} {
      allow read, write: if request.auth != null && request.auth.uid == vendorId;

      // Vendor subcollections (orders, payments) scoped to the vendor
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == vendorId;
      }
    }

    // Products/listings: only the vendor who owns the listing can read/write
    match /products/{productId} {
      allow read: if request.auth != null
                  && resource.data.vendorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.vendorId == request.auth.uid;
    }

    // New products (pending approval) — same ownership rules
    match /newProducts/{productId} {
      allow read: if request.auth != null
                  && resource.data.vendorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.vendorId == request.auth.uid;
    }

    // Orders: only the vendor involved can read their orders
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.vendorId == request.auth.uid;
      allow write: if false; // Orders are created by the customer-facing app or admin
    }

    // Details collection (product details) — same ownership as products
    match /details/{detailId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
